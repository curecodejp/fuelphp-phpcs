{
    "name": "eviweb/fuelphp-phpcs",
    "type": "phpcodesniffer-standard",
    "description": "PHP Code Sniffer standard for FuelPHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Eric Villard",
            "email": "dev@eviweb.fr",
            "homepage": "https://github.com/eviweb",
            "role": "developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "squizlabs/php_codesniffer": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
